DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=disable
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
FLASK_DEBUG=0
# Set to 1 when requests arrive through HTTPS (Render production)
COOKIE_SECURE=0
# Set to 1 only if deploying behind a trusted reverse proxy (Render)
BEHIND_PROXY=0
